# GEMINI_API_KEY: diperlukan untuk panggilan API Gemini AI. Pipeline penjanaan AI automatik
# DIMATIKAN sengaja (Fasa 8, 2026-08-02) — kod kekal wujud tapi tak dipanggil automatik lagi.
# Tetapkan sendiri di sini (atau pembolehubah persekitaran platform hosting) hanya jika/bila
# ciri chatbox AI manual dibina semula kelak.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SESSION_SECRET: rahsia untuk menandatangani kuki sesi log masuk (express-session).
# WAJIB ditetapkan sebelum deploy sebenar — tanpa ini server jana rahsia rawak setiap kali
# bermula dan SEMUA sesi log masuk terputus setiap kali server dimulakan semula.
# Jana satu contoh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="MY_SESSION_SECRET"

# RESEND_* (2026-08-03, Fasa 1): infrastruktur emel sebenar untuk jemputan editor baharu & set
# semula kata laluan sendiri (pautan bertoken, sah sementara). Guna Resend (API HTTPS), BUKAN
# SMTP — DigitalOcean sekat semua port SMTP keluar (465/587) secara lalai untuk Droplet
# baharu, Resend hantar via HTTPS biasa (port 443) yang terus elak sekatan tu. Tanpa
# RESEND_API_KEY ditetapkan, pelayan tetap berjalan seperti biasa (tak ranap) — ia cuma log
# satu amaran semasa mula dan emel jemputan/reset TAK akan dihantar (lihat core/email/MailSender.js).
#
# RESEND_API_KEY: dijana di dashboard resend.com → API Keys (kebenaran "Sending access" cukup,
# tak perlu "Full access") — rahsia, jangan kongsi/commit nilai sebenar.
RESEND_API_KEY="MY_RESEND_API_KEY"
# RESEND_FROM: header "From" emel yang dihantar — domain mesti sudah disahkan (verified) di
# Resend. Jika tak ditetapkan, kod jatuh balik kepada "Adjung Brief" <jemputan@mail.adjung.com>.
RESEND_FROM="Adjung Brief <jemputan@mail.adjung.com>"
