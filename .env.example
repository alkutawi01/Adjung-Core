# GEMINI_API_KEY: diperlukan untuk panggilan API Gemini AI. Pipeline penjanaan AI automatik
# DIMATIKAN sengaja (Fasa 8, 2026-08-02) — kod kekal wujud tapi tak dipanggil automatik lagi.
# Tetapkan sendiri di sini (atau pembolehubah persekitaran platform hosting) hanya jika/bila
# ciri chatbox AI manual dibina semula kelak.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SESSION_SECRET: rahsia untuk menandatangani kuki sesi log masuk (express-session).
# WAJIB ditetapkan sebelum deploy sebenar — tanpa ini server jana rahsia rawak setiap kali
# bermula dan SEMUA sesi log masuk terputus setiap kali server dimulakan semula.
# Jana satu contoh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="MY_SESSION_SECRET"

# SMTP_* (2026-08-03, Fasa 1): infrastruktur emel sebenar untuk jemputan editor baharu & set
# semula kata laluan sendiri (pautan bertoken, sah sementara). Tanpa keempat-empat
# SMTP_HOST/SMTP_USER/SMTP_PASS ditetapkan, pelayan tetap berjalan seperti biasa (tak ranap) —
# ia cuma log satu amaran semasa mula dan emel jemputan/reset TAK akan dihantar (lihat
# core/email/MailSender.js).
#
# SMTP_HOST: nama hos pelayan SMTP pembekal emel (cth Hostinger).
SMTP_HOST="smtp.hostinger.com"
# SMTP_PORT: port sambungan SMTP. 465 = TLS/SSL tersirat (yang dipakai kod ni — `secure: true`).
SMTP_PORT="465"
# SMTP_USER: alamat emel/akaun log masuk SMTP (mesej dihantar ATAS NAMA akaun ni).
SMTP_USER="editorial@adjung.com"
# SMTP_PASS: App Password yang dijana dalam panel Hostinger (BUKAN kata laluan log masuk akaun
# emel biasa) — rahsia, jangan kongsi/commit nilai sebenar.
SMTP_PASS="MY_SMTP_APP_PASSWORD"
# SMTP_FROM: header "From" emel yang dihantar. Jika tak ditetapkan, kod jatuh balik kepada
# "Adjung Brief" <editorial@adjung.com>.
SMTP_FROM="\"Adjung Brief\" <editorial@adjung.com>"
